{
  "name": "PhraseBridge",
  "short_name": "PhraseBridge",
  "description": "デバイス間でフレーズを共有する軽量ツール",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "share_target": {
    "action": "/share",
