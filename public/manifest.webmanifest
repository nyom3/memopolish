    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "background_color": "#f8fafc",
  "theme_color": "#0f172a",
  "lang": "ja",
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
